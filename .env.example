# Copy this file to .env and enter your EG4 Monitor credentials.
# NEVER commit .env to Git.

EG4_USERNAME=you@example.com
EG4_PASSWORD=replace-me
EG4_BASE_URL=https://monitor.eg4electronics.com
EG4_DISCOVERY_OUTPUT=eg4-discovery-sanitized.json

# Optional: set to 1 for extra endpoint diagnostics.
EG4_DEBUG=0
