{
  "pluginAlias": "EG4",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "EG4 cloud integration. v0.2 creates a read-only HomeKit system battery accessory and logs live system power data.",
  "footerDisplay": "Unofficial community plugin. Not affiliated with EG4 Electronics or Luxpower.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "EG4 Energy",
        "required": true
      },
      "username": {
        "title": "EG4 Monitor Username",
        "type": "string",
        "required": true
      },
      "password": {
        "title": "EG4 Monitor Password",
        "type": "string",
        "required": true
      },
      "baseUrl": {
        "title": "EG4 Monitor URL",
        "type": "string",
        "default": "https://monitor.eg4electronics.com",
        "required": true
      },
      "debugApi": {
        "title": "API Debug Logging",
        "type": "boolean",
        "default": false
      },
      "pollInterval": {
        "title": "Polling Interval (seconds)",
        "type": "integer",
        "default": 120,
        "minimum": 60,
        "maximum": 900,
        "required": true
      }
    }
  }
}
